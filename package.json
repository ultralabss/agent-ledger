{
  "name": "agent-ledger",
  "version": "0.1.0",
  "type": "module",
  "description": "Shared memory for parallel AI coding agents: tasks, decisions, file claims and history as plain markdown in git, behind a local hub.",
  "license": "MIT",
  "author": "Ultra Labs",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "hub": "node packages/hub/src/bin.ts",
    "ledger": "node packages/cli/src/bin.ts",
    "test": "node --test --test-timeout=60000 --test-concurrency=4 \"packages/*/src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && pnpm --filter @agent-ledger/web typecheck",
    "build": "node scripts/build-hook.mjs && pnpm --filter @agent-ledger/web build",
    "build:hook": "node scripts/build-hook.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "braces": ">=3.0.4"
    }
  }
}
