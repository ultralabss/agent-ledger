# Every path needs an owner's review (branch protection: "Require review from Code Owners").
# Owner: the maintainer's GitHub account (CI fails if the OWNER placeholder is ever put back).
*                              @fiuipko

# Supply chain, CI and installers: always the owner.
/.github/                      @fiuipko
/CODEOWNERS                    @fiuipko
/adapters/                     @fiuipko
/install.sh                    @fiuipko
/uninstall.sh                  @fiuipko
/package.json                  @fiuipko
/pnpm-lock.yaml                @fiuipko
/pnpm-workspace.yaml           @fiuipko
/.gitleaks.toml                @fiuipko
/scripts/                      @fiuipko
/SECURITY.md                   @fiuipko
/CONTRIBUTING.md               @fiuipko
/AGENTS.md                     @fiuipko
/packages/*/package.json       @fiuipko

# Security-relevant hub code.
/packages/hub/src/guard/       @fiuipko
/packages/hub/src/security/    @fiuipko
/packages/hub/src/http/        @fiuipko
/packages/hub/src/gitleaks.ts  @fiuipko
/packages/shared/src/secrets*  @fiuipko
